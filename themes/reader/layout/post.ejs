<article class="post">
  <header class="post-header">
    <time class="post-date"><%- date(page.date, 'D [de] MMMM [de] YYYY') %></time>
    <h1 class="post-title"><%= page.title %></h1>
  </header>
  <div class="post-content">
    <%- page.content %>
  </div>
</article>
<nav class="post-nav">
  <% if (page.prev) { %>
    <a class="post-nav-prev" href="<%- url_for(page.prev.path) %>">
      <span>← Anterior</span>
      <%= page.prev.title %>
    </a>
  <% } %>
  <% if (page.next) { %>
    <a class="post-nav-next" href="<%- url_for(page.next.path) %>">
      <span>Próxima →</span>
      <%= page.next.title %>
    </a>
  <% } %>
</nav>
