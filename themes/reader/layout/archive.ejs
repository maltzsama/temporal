<h1 class="archive-title">Todas as crônicas</h1>
<% let currentYear = null; %>
<% page.posts.each(function (post) { %>
  <% const year = full_date(post.date, 'YYYY'); %>
  <% if (year !== currentYear) { currentYear = year; %>
    <h2 class="archive-year"><%= year %></h2>
  <% } %>
  <article class="archive-item">
    <time class="archive-date"><%- date(post.date, 'DD/MM') %></time>
    <a class="archive-link" href="<%- url_for(post.path) %>"><%= post.title %></a>
  </article>
<% }) %>
